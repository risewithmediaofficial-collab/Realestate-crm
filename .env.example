# ==============================================================================
# REAL ESTATE CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database Configuration ───────────────────────────────────────────────────
# For local development outside Docker:
# MONGODB_URI=mongodb://localhost:27017/real_estate_crm
#
# For Docker Compose / VPS Deployment (uses service name 'mongo'):
MONGODB_URI=mongodb://mongo:27017/real_estate_crm

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=realestate_crm_jwt_secret_key_2024_secure_prod
JWT_EXPIRES_IN=7d

# ─── Meta Lead Ads Integration (Optional / Live Credentials) ─────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=prop_crm_webhook_verify_2026
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_API_VERSION=v21.0

# ─── Host VPS Port Mappings (Configured in docker-compose.yml) ─────────────────
# Frontend (Web Client):  http://YOUR_VPS_IP:88  or  http://YOUR_VPS_IP:8089
# Backend (Direct API):   http://YOUR_VPS_IP:5009
# MongoDB (Compass/DB):   mongodb://YOUR_VPS_IP:27025/real_estate_crm
#
# GitHub Secrets needed for CI/CD:
# - HOST:       Your VPS public IP address
# - USERNAME:   SSH login user (e.g. root or ubuntu)
# - SSH_KEY:    Private SSH key (contents of ~/.ssh/id_rsa or id_ed25519)
